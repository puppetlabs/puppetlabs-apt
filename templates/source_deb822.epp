<%- |
  String[1] $comment,
  Enum['yes','no'] $enabled,
  Array[String[1]] $types,
  Array[String[1]] $uris,
  Array[String[1]] $suites,
  Optional[Array[String[1]]] $components = undef,
  Optional[Array[String[1]]] $architectures = undef,
  Optional[Enum['yes','no']] $allow_insecure = undef,
  Optional[Enum['yes','no']] $repo_trusted = undef,
  Optional[Enum['yes','no']] $check_valid_until = undef,
  Optional[Variant[String[1],Array[String[1]]]] $signed_by = undef,
  Hash[String, String] $advanced_options = {},
| -%>
# <%= $comment %>
Enabled: <%= $enabled %>
Types: <%= $types.join(' ') %>
URIs: <%= $uris.join(' ') %>
Suites: <%= $suites.join(' ') %>
<% if $components { -%>
Components: <%= $components.join(' ') %>
<% } -%>
<% if $architectures { -%>
Architectures: <%= $architectures.join(' ') %>
<% } -%>
<% if $allow_insecure { -%>
Allow-Insecure: <%= $allow_insecure %>
<% } -%>
<% if $repo_trusted { -%>
Trusted: <%= $repo_trusted %>
<% } -%>
<% if $check_valid_until { -%>
Check-Valid-Until: <%= $check_valid_until %>
<% } -%>
<% if $signed_by { -%>
<% if $signed_by =~ Apt::Source_key { -%>
Signed-By:
<%= regsubst(regsubst(regsubst($signed_by, '\n\z', ''), '^$', '.', 'G'), '^', ' ', 'G') %>
<% } else { -%>
Signed-By: <%= [$signed_by].flatten.join(' ') %>
<% } -%>
<% } -%>
<% $advanced_options.each |$field, $value| { -%>
<%= $field %>: <%= $value %>
<% } -%>
